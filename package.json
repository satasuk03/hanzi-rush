{
  "name": "hanzi-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply hanzi-rush --local",
    "db:remote": "wrangler d1 migrations apply hanzi-rush --remote",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "npm run test:wallet && npm run test:shop && npm run test:deals && npm run test:ownership && npm run test:card && npm run test:titles && npm run test:boards && npm run test:continue && npm run test:signin",
    "test:wallet": "node scripts/test-wallet.mjs",
    "test:shop": "node scripts/test-shop.mjs",
    "test:deals": "node scripts/test-deals.mjs",
    "test:ownership": "node scripts/test-ownership.mjs",
    "test:card": "node scripts/test-card.mjs",
    "test:titles": "node scripts/test-titles.mjs",
    "typecheck:api": "tsc -p functions/tsconfig.json",
    "deploy": "npm run build && wrangler pages deploy",
    "test:boards": "node scripts/test-boards.mjs",
    "test:continue": "node scripts/test-continue.mjs",
    "test:signin": "node scripts/test-signin.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-social-login": "8.5.11",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wrangler": "^4.147.0"
  }
}
