{
  "name": "hanzi-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply hanzi-rush --local",
    "db:remote": "wrangler d1 migrations apply hanzi-rush --remote",
    "test:wallet": "node scripts/test-wallet.mjs",
    "test:shop": "node scripts/test-shop.mjs",
    "test:deals": "node scripts/test-deals.mjs",
    "test:ownership": "node scripts/test-ownership.mjs",
    "test:card": "node scripts/test-card.mjs",
    "test:titles": "node scripts/test-titles.mjs",
    "typecheck:api": "tsc -p functions/tsconfig.json",
    "deploy": "npm run build && wrangler pages deploy",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor '#2a1a3a' --iconBackgroundColorDark '#2a1a3a' --splashBackgroundColor '#1b6fd1' --splashBackgroundColorDark '#1b6fd1'"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wrangler": "^4.147.0"
  }
}
